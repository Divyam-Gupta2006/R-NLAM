# R-NLAM Environment Configuration Example

# Database
DATABASE_URL="postgresql://rnlam_user:rnlam_password@localhost:5432/rnlam_db?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# MinIO Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_BUCKET="rnlam-documents"

# Keycloak Authentication
KEYCLOAK_SERVER_URL="http://localhost:8080"
KEYCLOAK_REALM="rnlam"
KEYCLOAK_CLIENT_ID="rnlam-app"

# Application Ports
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_AI_URL="http://localhost:8000"

