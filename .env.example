# R-NLAM configuration. Copy the backend part to backend/.env
# (scripts/db-setup.ps1 writes DATABASE_URL for you).

# --- backend ---------------------------------------------------------------
# User-space Postgres 17 + PostGIS on 5433 (see README "Low-RAM quick start")
DATABASE_URL=postgresql://rnlam:<password>@localhost:5433/rnlam?schema=public
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Auth: dev = backend signs its own JWTs (no Keycloak); keycloak = verify RS256 via JWKS
AUTH_MODE=dev
DEV_JWT_SECRET=<at least 32 random characters>
# KEYCLOAK_ISSUER=http://localhost:8085/realms/rnlam
# KEYCLOAK_JWKS_URI=http://localhost:8085/realms/rnlam/protocol/openid-connect/certs

# Adapters (lightweight defaults; heavy options are documented stubs)
EVENT_BUS=outbox            # outbox | kafka (stub)
STORAGE_BACKEND=local       # local | minio (stub)
STORAGE_DIR=./storage
LLM_PROVIDER=template       # template | openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama / llama.cpp server
# LLM_MODEL=llama3.1:8b

# Pin the clock for a repeatable demo (statutory countdowns, interest accrual)
# DEMO_NOW=2026-10-01T10:00:00+05:30

# --- frontend (frontend/.env.local) -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AI_URL=http://localhost:8000/api/v1
