{
  "name": "rnlam-backend",
  "version": "1.0.0",
  "description": "R-NLAM Real-Time National Land Acquisition & Management System Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node -r dotenv/config src/main.ts",
    "start:dev": "npm run db:start && ts-node-dev --respawn --transpile-only -r dotenv/config src/main.ts",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "ts-node -r dotenv/config prisma/seed.ts",
    "seed": "ts-node -r dotenv/config prisma/seed-demo.ts",
    "seed:demo": "ts-node -r dotenv/config prisma/seed-demo.ts",
    "seed:demo:reset": "ts-node -r dotenv/config scripts/reset-demo.ts",
    "validate:demo": "ts-node -r dotenv/config scripts/validate-demo.ts",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/db-start.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/db-stop.ps1",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/db-status.ps1"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@prisma/client": "^5.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
