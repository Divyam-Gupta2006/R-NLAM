// R-NLAM (Real-Time National Land Acquisition & Management System)
//
// Conventions
// - Money: BigInt paise (1 rupee = 100 paise). Never Float.
// - Time: DateTime columns are UTC; the UI renders IST.
// - Geometry: `Parcel.geometry` (GeoJSON, what the API speaks) is the source of
//   truth; a trigger keeps the PostGIS column `geom` (not visible to Prisma) and
//   `areaSqm` in sync. Spatial queries use raw SQL against `geom`.
// - PostGIS/pg_trgm/fuzzystrmatch live in schema `extensions` (see scripts/db-setup.ps1).
//   Prisma pins search_path to "public" per connection, so raw SQL must qualify
//   them: extensions.ST_Intersects(...), ::extensions.geography.
// - Every lifecycle change goes through LifecycleService, which writes
//   StateTransition + AuditEvent + OutboxEvent in one transaction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CENTRAL_ADMIN
  CENTRAL_OFFICER
  STATE_ADMIN
  STATE_OFFICER
  DISTRICT_OFFICER
  PIA_OFFICER
  FIELD_OFFICER
  RR_OFFICER
  FINANCE_OFFICER
  GIS_OFFICER
  CITIZEN
}

enum JurisdictionLevel {
  NATION
  STATE
  DISTRICT
  TEHSIL
  VILLAGE
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_SCRUTINY
  APPROVED
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_SCRUTINY
  QUERY_RAISED
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Parcel lifecycle under RFCTLARR 2013. Holds (GIS gate, stay orders, open
/// objections) are guards on transitions, not stages.
enum ParcelStage {
  IDENTIFIED
  PRELIM_NOTIFIED
  DECLARED
  AWARDED
  COMPENSATION_PAID
  POSSESSION_TAKEN
  HANDED_OVER
  LAPSED
  WITHDRAWN
}

enum VerificationStatus {
  UNVERIFIED
  SYSTEM_MATCHED
  OFFICER_VERIFIED
  DISCREPANCY
  DISPUTED
}

enum NoticeKind {
  SEC_4_SIA
  SEC_11_PRELIMINARY
  SEC_19_DECLARATION
  SEC_21_NOTICE
  SEC_23_AWARD
}

enum ObjectionStatus {
  SUBMITTED
  UNDER_REVIEW
  HEARING_SCHEDULED
  RESOLVED
  REJECTED
  ESCALATED
}

enum HearingStatus {
  SCHEDULED
  HELD
  ADJOURNED
  CANCELLED
}

enum AwardStatus {
  DRAFT
  DECLARED
  REVISED
  CHALLENGED
}

enum CompensationStatus {
  ASSESSED
  APPROVED
  INITIATED
  PAID
  FAILED
  DISPUTED
  ON_HOLD
}

enum RRStatus {
  IDENTIFIED
  ELIGIBILITY_VERIFIED
  PLAN_CREATED
  BENEFIT_ASSIGNED
  BENEFIT_DELIVERED
  COMPLETED
}

enum EntitlementStatus {
  ASSIGNED
  DELIVERED
  WAIVED
}

enum PossessionStatus {
  ELIGIBLE
  SCHEDULED
  POSSESSION_TAKEN
  HANDED_TO_PIA
}

enum DocumentKind {
  GAZETTE_NOTIFICATION
  AWARD_COPY
  KHASRA_EXTRACT
  SIA_REPORT
  GRAM_SABHA_CONSENT
  FRA_SETTLEMENT_CERTIFICATE
  FOREST_CLEARANCE
  CRZ_CLEARANCE
  WILDLIFE_CLEARANCE
  POSSESSION_CERTIFICATE
  PAYMENT_ADVICE
  COURT_ORDER
  FIELD_PHOTO
  OTHER
}

model Organization {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  type      String // PIA, CALA, STATE_DEPT, CENTRAL_DEPT
  stateCode String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
}

/// Administrative hierarchy used for scoping and liability roll-ups.
/// Codes follow LGD style but are synthetic in the demo dataset.
model Jurisdiction {
  id        String            @id @default(uuid())
  level     JurisdictionLevel
  code      String            @unique
  name      String
  nameLocal String?
  parentId  String?
  parent    Jurisdiction?     @relation("JurisdictionTree", fields: [parentId], references: [id])
  children  Jurisdiction[]    @relation("JurisdictionTree")
  stateCode String
  createdAt DateTime          @default(now())

  users   User[]
  parcels Parcel[]

  @@index([parentId])
  @@index([stateCode, level])
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  phone          String?
  role           RoleName      @default(CITIZEN)
  designation    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  personId       String?       @unique
  person         Person?       @relation(fields: [personId], references: [id])
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transitions StateTransition[]
  audits      AuditEvent[]
}

model Project {
  id                 String        @id @default(uuid())
  code               String        @unique
  name               String
  sector             String // Roads, Railways, Energy, Urban, Industrial
  description        String?
  stateCode          String
  stateName          String
  districtCodes      String[]
  districtNames      String[]
  piaOrgId           String?
  piaOrg             Organization? @relation(fields: [piaOrgId], references: [id])
  piaName            String
  actCode            String        @default("RFCTLARR_2013")
  requiredAreaHa     Float
  estimatedCostPaise BigInt
  status             ProjectStatus @default(DRAFT)
  alignment          Json? // GeoJSON LineString/MultiLineString
  isSynthetic        Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  proposals       Proposal[]
  parcels         Parcel[]
  notices         StatutoryNotice[]
  slaTasks        SLATask[]
  awards          Award[]
  compensations   Compensation[]
  rrCases         RRCase[]
  possessions     Possession[]
  documents       Document[]
  riskAssessments RiskAssessment[]
  families        AffectedFamily[]
}

model Proposal {
  id             String         @id @default(uuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  landRequiredHa Float
  alignmentGeo   Json?
  status         ProposalStatus @default(DRAFT)
  remarks        String?
  submittedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

/// A gazette notification. One notice covers many parcels (often a village).
model StatutoryNotice {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        NoticeKind
  referenceNo String
  gazetteRef  String?
  publishedOn DateTime
  documentId  String?
  createdAt   DateTime   @default(now())

  parcels Parcel[]

  @@index([projectId, kind])
}

model Parcel {
  id                   String                                      @id @default(uuid())
  projectId            String
  project              Project                                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcelNumber         String
  surveyNumber         String // khasra / survey / gat number as recorded
  ulpin                String? // 14-digit Unique Land Parcel Identification Number
  villageId            String
  village              Jurisdiction                                @relation(fields: [villageId], references: [id])
  villageName          String
  districtCode         String
  districtName         String
  stateCode            String
  stateName            String
  totalAreaHa          Float
  acquiredAreaHa       Float                                       @default(0)
  landClass            String // Agricultural (irrigated/dry), Residential, Commercial, Forest, Government
  landUse              String?
  isRural              Boolean                                     @default(true)
  distanceFromUrbanKm  Float?
  marketRatePaisePerHa BigInt? // circle/guideline rate in force, for the award calculation
  stage                ParcelStage                                 @default(IDENTIFIED)
  verificationState    VerificationStatus                          @default(UNVERIFIED)
  displayOwnerName     String // as shown in lists; the holders table is authoritative
  geometry             Json? // GeoJSON Polygon/MultiPolygon, EPSG:4326
  areaSqm              Float? // maintained by trigger from geom
  geom                 Unsupported("geometry(MultiPolygon,4326)")? // PostGIS; set by trigger
  familiesAffected     Int                                         @default(0)
  /// s.40 urgency direction under which possession preceded the award/payment
  urgencyOrderRef      String?
  isSynthetic          Boolean                                     @default(true)
  createdAt            DateTime                                    @default(now())
  updatedAt            DateTime                                    @updatedAt

  notices       StatutoryNotice[]
  holders       ParcelHolder[]
  caseLinks     CaseLink[]
  fieldEvidence FieldEvidence[]
  verifications ParcelVerification[]
  objections    Objection[]
  awards        Award[]
  compensations Compensation[]
  rrCases       RRCase[]
  possessions   Possession[]
  documents     Document[]
  provenance    DataProvenance[]

  @@unique([projectId, parcelNumber])
  @@index([projectId, stage])
  @@index([villageId])
  @@index([districtCode])
  @@index([geom], map: "Parcel_geom_gist", type: Gist)
}

/// A natural person appearing in any record (land records, award, field survey).
/// Names are stored as recorded; reconciliation links variants of the same person.
model Person {
  id              String   @id @default(uuid())
  name            String // as recorded (any script)
  nameScript      String   @default("Latn") // ISO 15924: Latn, Deva, ...
  fatherName      String?
  gender          String?
  phone           String?
  idHash          String? // salted hash of an ID number; raw IDs are never stored
  villageCode     String?
  source          String   @default("LAND_RECORDS") // LAND_RECORDS, AWARD, FIELD_SURVEY, ECOURTS
  isSynthetic     Boolean  @default(true)
  /// Shared by records confirmed to be the same person (6.5)
  identityGroupId String?
  createdAt       DateTime @default(now())

  holdings      ParcelHolder[]
  user          User?
  compensations Compensation[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "Person_name_trgm", type: Gin)
}

model ParcelHolder {
  id             String   @id @default(uuid())
  parcelId       String
  parcel         Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  personId       String
  person         Person   @relation(fields: [personId], references: [id])
  sharePct       Float    @default(100)
  nameAsRecorded String
  source         String   @default("LAND_RECORDS")
  createdAt      DateTime @default(now())

  @@unique([parcelId, personId, source])
}

model LandRecordReference {
  id          String   @id @default(uuid())
  surveyNo    String
  villageCode String
  ownerName   String
  areaHa      Float
  recordDate  DateTime
  source      String   @default("STATE_LAND_RECORDS_SYNTHETIC")
  rawData     Json
  createdAt   DateTime @default(now())
}

model ParcelVerification {
  id            String             @id @default(uuid())
  parcelId      String
  parcel        Parcel             @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  verifiedById  String
  latitude      Float
  longitude     Float
  accuracyM     Float?
  photoUrl      String?
  notes         String?
  status        VerificationStatus @default(OFFICER_VERIFIED)
  isOfflineSync Boolean            @default(false)
  createdAt     DateTime           @default(now())
}

model Notification {
  id           String    @id @default(uuid())
  userId       String?
  role         RoleName?
  stateCode    String?
  districtCode String?
  title        String
  message      String
  type         String // SLA_BREACH, STATUTORY_DEADLINE, TASK_ASSIGNMENT, APPROVAL, GIS_BLOCK
  severity     String    @default("INFO") // INFO, WARNING, CRITICAL
  entityType   String?
  entityId     String?
  dedupeKey    String?   @unique // prevents duplicate T-60/T-30/T-7 alerts
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([role, isRead])
}

model Objection {
  id          String          @id @default(uuid())
  parcelId    String
  parcel      Parcel          @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  applicant   String
  category    String // COMPENSATION_AMOUNT, MEASUREMENT, TITLE, PUBLIC_PURPOSE, OTHER
  description String
  filedOn     DateTime        @default(now())
  status      ObjectionStatus @default(SUBMITTED)
  resolution  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  hearings Hearing[]
}

model Hearing {
  id               String        @id @default(uuid())
  objectionId      String
  objection        Objection     @relation(fields: [objectionId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime
  venue            String
  presidingOfficer String
  status           HearingStatus @default(SCHEDULED)
  outcome          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

/// Award for one parcel. Components are stored with the calculation trace so a
/// citizen and an auditor can see exactly how the total was reached.
model Award {
  id                    String      @id @default(uuid())
  awardNumber           String      @unique
  projectId             String
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcelId              String
  parcel                Parcel      @relation(fields: [parcelId], references: [id])
  awardDate             DateTime
  marketValuePaise      BigInt
  multiplier            Decimal     @db.Decimal(4, 2)
  assetsValuePaise      BigInt      @default(0)
  solatiumPaise         BigInt
  additionalAmountPaise BigInt
  totalPaise            BigInt
  calculation           Json // step-by-step trace incl. rule citations
  status                AwardStatus @default(DECLARED)
  createdAt             DateTime    @default(now())

  compensations Compensation[]

  @@index([parcelId])
}

model Compensation {
  id               String             @id @default(uuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id])
  parcelId         String
  parcel           Parcel             @relation(fields: [parcelId], references: [id])
  awardId          String?
  award            Award?             @relation(fields: [awardId], references: [id])
  personId         String?
  person           Person?            @relation(fields: [personId], references: [id])
  beneficiaryName  String
  sharePct         Float              @default(100)
  bankAccountLast4 String? // full account numbers are never stored
  ifscCode         String?
  amountPaise      BigInt
  status           CompensationStatus @default(ASSESSED)
  paidOn           DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  paymentReferences PaymentReference[]

  @@index([status])
  @@index([parcelId])
}

model PaymentReference {
  id             String       @id @default(uuid())
  compensationId String
  compensation   Compensation @relation(fields: [compensationId], references: [id], onDelete: Cascade)
  utrNumber      String       @unique
  gatewaySource  String       @default("PFMS_SYNTHETIC")
  amountPaise    BigInt
  status         String       @default("SUCCESS")
  transactedAt   DateTime     @default(now())
}

model AffectedFamily {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  headName      String
  headNameLocal String?
  familySize    Int
  idHash        String
  villageName   String
  category      String   @default("LANDOWNER") // LANDOWNER, LANDLESS_LABOURER, TENANT, ARTISAN, SC_ST
  isVulnerable  Boolean  @default(false)
  isDisplaced   Boolean  @default(false)
  createdAt     DateTime @default(now())

  rrCases RRCase[]
}

/// Catalogue of R&R entitlements (Second Schedule of RFCTLARR 2013).
model Entitlement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String // HOUSING, GRANT, ANNUITY, EMPLOYMENT, TRANSPORT, SUBSISTENCE
  amountPaise BigInt?
  description String
  citation    String?
  createdAt   DateTime @default(now())

  grants RREntitlementGrant[]
}

model RRCase {
  id        String         @id @default(uuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id])
  parcelId  String
  parcel    Parcel         @relation(fields: [parcelId], references: [id])
  familyId  String
  family    AffectedFamily @relation(fields: [familyId], references: [id])
  status    RRStatus       @default(IDENTIFIED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  grants RREntitlementGrant[]

  @@index([parcelId])
}

model RREntitlementGrant {
  id            String            @id @default(uuid())
  caseId        String
  case          RRCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entitlementId String
  entitlement   Entitlement       @relation(fields: [entitlementId], references: [id])
  amountPaise   BigInt?
  status        EntitlementStatus @default(ASSIGNED)
  deliveredOn   DateTime?
  remarks       String?
  createdAt     DateTime          @default(now())
}

model Possession {
  id           String           @id @default(uuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id])
  parcelId     String           @unique
  parcel       Parcel           @relation(fields: [parcelId], references: [id])
  status       PossessionStatus @default(ELIGIBLE)
  scheduledOn  DateTime?
  takenOn      DateTime?
  handedOverOn DateTime?
  authority    String?
  latitude     Float?
  longitude    Float?
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Document {
  id             String       @id @default(uuid())
  kind           DocumentKind @default(OTHER)
  title          String
  fileName       String
  storageBackend String       @default("local") // local | minio
  storageKey     String
  sha256         String
  mimeType       String
  sizeBytes      Int
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  parcelId       String?
  parcel         Parcel?      @relation(fields: [parcelId], references: [id])
  referenceNo    String? // e.g. forest clearance F.No., Gram Sabha resolution no.
  issuedOn       DateTime?
  uploadedById   String?
  isSynthetic    Boolean      @default(true)
  createdAt      DateTime     @default(now())

  versions    DocumentVersion[]
  extractions DocumentExtraction[]

  @@index([parcelId, kind])
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String
  sha256     String
  uploadedAt DateTime @default(now())
}

model SLATask {
  id            String    @id @default(uuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  taskName      String
  assignedRole  RoleName
  slaDays       Int
  startDate     DateTime  @default(now())
  targetDate    DateTime
  completedDate DateTime?
  isBreached    Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

/// Append-only record of every lifecycle transition, written by LifecycleService.
model StateTransition {
  id         String    @id @default(uuid())
  entityType String // Parcel, Objection, Hearing, Compensation, RRCase, Possession, Project, Proposal
  entityId   String
  event      String
  fromState  String
  toState    String
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id])
  actorRole  RoleName?
  reason     String?
  override   Boolean   @default(false) // a guard was overridden by a senior officer
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
}

/// Tamper-evident audit chain. hash = SHA-256(prevHash || canonicalJSON(fields)).
/// `seq` fixes the order; inserts are serialised with an advisory lock.
model AuditEvent {
  seq           BigInt   @id @default(autoincrement())
  id            String   @unique @default(uuid())
  actorId       String?
  user          User?    @relation(fields: [actorId], references: [id])
  actorRole     String
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  reason        String?
  highlighted   Boolean  @default(false)
  requestId     String?
  timestamp     DateTime
  previousHash  String
  hash          String   @unique

  @@index([entityType, entityId])
}

/// Transactional outbox. Rows are written in the same transaction as the state
/// change and delivered by the dispatcher (at-least-once).
model OutboxEvent {
  seq           BigInt    @id @default(autoincrement())
  id            String    @unique @default(uuid())
  type          String // e.g. parcel.stage_changed.v1
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime  @default(now())
  dispatchedAt  DateTime?
  attempts      Int       @default(0)
  lastError     String?

  @@index([dispatchedAt])
  @@index([aggregateType, aggregateId])
}

model DataProvenance {
  id                 String    @id @default(uuid())
  parcelId           String
  parcel             Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  fieldName          String
  value              String
  source             String
  sourceRecordId     String?
  capturedAt         DateTime  @default(now())
  verifiedAt         DateTime?
  verifiedBy         String?
  verificationStatus String    @default("UNVERIFIED")
}

model RiskAssessment {
  id                  String   @id @default(uuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  riskScore           Float
  riskLevel           String
  contributingFactors Json
  recommendation      String
  model               String   @default("synthetic-rf-v1")
  assessedAt          DateTime @default(now())
}

model AnalyticsQuery {
  id        String   @id @default(uuid())
  question  String
  sqlQuery  String
  userRole  RoleName
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 6.1 Statutory rule engine: rules are data, versioned and cited.
// ---------------------------------------------------------------------------

enum RulePackStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// A versioned set of statutory rules for one act, centrally or for one state,
/// in force between effectiveFrom and effectiveTo. State packs override the
/// central pack key by key; keys a state pack does not define are inherited.
model RulePack {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. IN-RFCTLARR-2013-v1, MH-RFCTLARR-2013-v1
  actCode       String // RFCTLARR_2013
  stateCode     String? // null = central (all states)
  version       Int
  title         String
  source        String // where the text was verified, e.g. India Code (Act 30 of 2013)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        RulePackStatus @default(DRAFT)
  createdAt     DateTime       @default(now())

  entries RuleEntry[]

  @@index([actCode, stateCode, status])
}

/// One rule: a typed value with its legal citation and, where verified, the
/// statutory text it comes from. `unverified` rules are flagged in the UI.
model RuleEntry {
  id         String   @id @default(uuid())
  packId     String
  pack       RulePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  key        String // e.g. deadline.award.months, money.solatium.bp
  category   String // DEADLINE, MONEY, DOCUMENT, PROCEDURE, ALERT
  label      String
  value      Json
  unit       String?
  citation   String
  quote      String? // verbatim statutory text
  unverified Boolean  @default(false)
  note       String?

  @@unique([packId, key])
}

enum ClockKind {
  OBJECTION_WINDOW
  DECLARATION_DEADLINE
  AWARD_DEADLINE
  PAYMENT_DEADLINE
  RR_MONETARY_DEADLINE
}

enum ClockStatus {
  RUNNING
  MET
  MISSED
}

/// A statutory clock on one parcel, derived from notices, awards and payments
/// by StatutoryService. Recomputed whenever the parcel's events change.
model StatutoryClock {
  id           String      @id @default(uuid())
  parcelId     String
  projectId    String
  districtCode String
  stateCode    String
  noticeId     String? // the notice that started the clock (groups parcels in the calendar)
  kind         ClockKind
  startsOn     DateTime
  dueOn        DateTime
  status       ClockStatus
  metOn        DateTime?
  excludedDays Int         @default(0) // court stay periods excluded from the count
  ruleKey      String
  packCode     String
  citation     String
  consequence  String
  unverified   Boolean     @default(false)
  updatedAt    DateTime    @updatedAt

  @@unique([parcelId, kind])
  @@index([status, dueOn])
  @@index([districtCode, status])
}

// ---------------------------------------------------------------------------
// 6.3 Geo-gated consent: constraint layers and parcel overlaps.
// ---------------------------------------------------------------------------

enum ConstraintKind {
  FOREST
  SCHEDULED_AREA
  FRA_CLAIM
  CRZ
  PROTECTED_AREA
}

/// A regulatory layer (forest, Fifth Schedule area, FRA claim, CRZ, protected
/// area). GeoJSON is the source; a trigger maintains the PostGIS `geom`.
model ConstraintLayer {
  id          String                                      @id @default(uuid())
  code        String                                      @unique
  kind        ConstraintKind
  name        String
  source      String
  isSynthetic Boolean                                     @default(true)
  geometry    Json
  geom        Unsupported("geometry(MultiPolygon,4326)")?
  areaSqm     Float?
  createdAt   DateTime                                    @default(now())

  overlaps ParcelConstraint[]

  @@index([geom], map: "ConstraintLayer_geom_gist", type: Gist)
}

/// A parcel's overlap with a constraint layer, computed by PostGIS.
model ParcelConstraint {
  id              String          @id @default(uuid())
  parcelId        String
  layerId         String
  layer           ConstraintLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  overlapSqm      Float
  overlapPct      Float
  overlapGeometry Json
  detectedAt      DateTime        @default(now())

  @@unique([parcelId, layerId])
  @@index([parcelId])
}

// ---------------------------------------------------------------------------
// 6.4 Why-Stuck: officer decisions on bottleneck briefs (feed back into ranking).
// ---------------------------------------------------------------------------

enum BriefDecision {
  ACCEPTED
  DISPUTED
}

model BottleneckDecision {
  id        String        @id @default(uuid())
  key       String // stable bottleneck key, e.g. GIS:<parcelId>
  projectId String
  decision  BriefDecision
  comment   String
  actorId   String
  actorRole RoleName
  createdAt DateTime      @default(now())

  @@index([key, createdAt])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// 6.5 Owner reconciliation: candidate identity links, never silent merges.
// ---------------------------------------------------------------------------

enum MatchStatus {
  PENDING
  AUTO_LINKED
  CONFIRMED
  REJECTED
  UNLINKED
}

/// A possible "same person" link between two Person records from different
/// sources or scripts. Records are never merged; confirming sets a shared
/// identityGroupId and is audited.
model PersonMatch {
  id            String      @id @default(uuid())
  personAId     String
  personBId     String
  confidence    Float
  reasons       Json
  requiresHuman Boolean     @default(true)
  status        MatchStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([personAId, personBId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 6.7 Periodic Merkle roots over the audit chain.
// ---------------------------------------------------------------------------

/// Root of an RFC 6962 Merkle tree over audit entries fromSeq..toSeq (one IST
/// day, or everything unsealed when sealed manually). Roots are themselves
/// chained, so a rewritten root is detectable too.
model MerkleRoot {
  id          String   @id @default(uuid())
  period      String // e.g. 2026-09-29, or "manual"
  fromSeq     BigInt
  toSeq       BigInt
  leafCount   Int
  root        String
  prevChain   String
  chainHash   String   @unique
  periodStart DateTime
  periodEnd   DateTime
  sealedAt    DateTime @default(now())

  @@index([fromSeq, toSeq])
}

enum ExtractionStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

/// Fields proposed by the AI service for a document (6.8). Proposals only:
/// nothing is used until a person confirms or corrects them.
model DocumentExtraction {
  id                     String           @id @default(uuid())
  documentId             String
  document               Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentSha256         String // the file version the fields were read from
  textMethod             String // pdf-text-layer | plain-text | tesseract
  documentType           String
  documentTypeConfidence Float
  proposed               Json // { field: [{ value, confidence, evidence, needs_review }] }
  needsReview            Boolean
  status                 ExtractionStatus @default(PENDING_REVIEW)
  confirmed              Json? // { field: value[] } as accepted or corrected by a person
  corrections            Int? // number of fields changed by the reviewer
  reviewNote             String?
  requestedById          String?
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime         @default(now())

  @@index([documentId, createdAt])
}

enum CourtCaseCategory {
  TITLE_SUIT // partition, declaration of title, injunction over the land itself
  LAR_REFERENCE // s.64 reference to the LARR Authority against an award
  WRIT_PETITION
  OTHER
}

enum CourtCaseStatus {
  PENDING
  DISPOSED
}

enum CaseLinkStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

/// A court case as fetched from eCourts/NJDG (6.9). The default adapter is
/// synthetic; `source` says where each record came from.
model CourtCase {
  id            String            @id @default(uuid())
  cnr           String            @unique // eCourts Case Number Record
  courtName     String
  caseType      String // as the court registers it, e.g. "Special Civil Suit"
  caseNumber    String
  category      CourtCaseCategory
  status        CourtCaseStatus
  stayOrder     Boolean           @default(false)
  filedOn       DateTime
  nextHearingOn DateTime?
  disposedOn    DateTime?
  petitioners   String[]
  respondents   String[]
  subject       String
  surveyNumbers String[]
  villageName   String?
  districtCode  String
  source        String            @default("ECOURTS_SYNTHETIC")
  isSynthetic   Boolean           @default(true)
  fetchedAt     DateTime          @default(now())

  links CaseLink[]

  @@index([districtCode])
}

/// A proposed link between a court case and a parcel. Always a candidate
/// until an officer confirms or rejects it; only confirmed links count.
model CaseLink {
  id           String         @id @default(uuid())
  courtCaseId  String
  courtCase    CourtCase      @relation(fields: [courtCaseId], references: [id], onDelete: Cascade)
  parcelId     String
  parcel       Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  score        Float
  reasons      Json // [{ signal, detail, weight }]
  status       CaseLinkStatus @default(CANDIDATE)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([courtCaseId, parcelId])
  @@index([parcelId, status])
}

enum FieldEvidenceKind {
  POINT
  POLYGON
}

enum FieldEvidenceStatus {
  ACCEPTED
  CONFLICT // another survey of the parcel arrived that this device had not seen; a supervisor decides
  SUPERSEDED
  REJECTED
}

/// GNSS evidence captured in the field, possibly offline (6.10). The device
/// seals each bundle with a SHA-256 over its canonical JSON; the server
/// recomputes it and every photo hash before accepting.
model FieldEvidence {
  id               String              @id @default(uuid())
  clientId         String              @unique // generated on the device; makes upload idempotent
  deviceId         String
  parcelId         String
  parcel           Parcel              @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  capturedById     String
  capturedAt       DateTime // device clock (UTC)
  receivedAt       DateTime            @default(now())
  baseSyncedAt     DateTime? // when the device last saw the server's evidence for this parcel
  kind             FieldEvidenceKind
  geometry         Json // GeoJSON Point or Polygon, EPSG:4326
  accuracyM        Float // horizontal accuracy reported by the device (worst sample)
  samples          Int                 @default(1)
  note             String?
  photoDocumentIds String[]
  photoHashes      String[]
  bundleHash       String // as sealed on the device
  hashVerified     Boolean
  distanceM        Float? // point: distance from the recorded boundary (0 = inside)
  overlapIoU       Float? // polygon: intersection over union with the recorded boundary
  capturedAreaSqm  Float?
  status           FieldEvidenceStatus
  conflictReason   String?
  conflictWithId   String?
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?

  @@index([parcelId, receivedAt])
}
